{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "demo-project backend service: HTTP API skeleton with /healthz liveness endpoint",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm smoke"
  },
  "dependencies": {
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
