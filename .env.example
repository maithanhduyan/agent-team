# ==========================================================
# ai-dev-team — environment configuration
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env.
# ==========================================================

# DeepSeek API key used by every DSH agent container.
# DSH reads the standard DEEPSEEK_API_KEY environment variable.
DEEPSEEK_API_KEY=

# ----------------------------------------------------------
# agent-desktop — memory foundation (v0.4, spec docs/memory-spec.md §11)
# ----------------------------------------------------------
# Memory data directory (canonical layout: memory/ inside the
# agent-desktop project root). Empty = <project>/memory.
MEMORY_DIR=
# sessions.jsonl rotation size in MB (spec §5.5; default 100).
MEMORY_ROTATE_MB=100
# Extra comma-separated injection patterns appended to the shipped
# defaults (spec §10.2.2; defaults are never replaced).
MEMORY_INJECTION_PATTERNS=
# --- Retrieval (T04, spec §7.1) ---
# search_memory weights: score = ALPHA·similarity + BETA·recency +
# GAMMA·importance. MUST sum to 1 (validated at load; misconfiguration
# is a hard error). Defaults 0.5 / 0.3 / 0.2.
MEMORY_ALPHA=0.5
MEMORY_BETA=0.3
MEMORY_GAMMA=0.2
# Recency decay half-life in days (spec §7.1; default 30, Day-30 policy).
MEMORY_RECENCY_HALF_LIFE_DAYS=30
# --- Hot facts (T04, spec §6.3) ---
# Min importance for a fact to be injected as hot (default 0.8).
MEMORY_HOT_IMPORTANCE=0.8
# Max hot facts injected into the system prompt at session start (default 10).
MEMORY_HOT_MAX=10
# --- Agentic retrieval (T04, spec §7.3) ---
# Per-turn memory tool-call budget (search_memory/grep_logs) for
# long-history queries (default 5).
MEMORY_MAX_TOOL_CALLS_PER_TURN=5
# DSH run-log directory for grep_logs(files: "runs") (spec §7.2;
# default <project>/.agent-team/runs).
MEMORY_RUNS_DIR=
# --- Consolidation (T05, spec §8–§10) ---
# Graduation observation count N (spec §8.4). Validated to 3..5 at boot
# (hard error outside the range). Default 3.
MEMORY_GRADUATION_N=3
# Day-30 decay period in days (spec §10.4; default 30).
MEMORY_DECAY_DAYS=30
# Verifier citation token-overlap threshold (spec §10.5; default 0.3).
MEMORY_VERIFY_MIN_OVERLAP=0.3
# Consolidation schedule interval in minutes (spec §8.1; default 360).
MEMORY_CONSOLIDATE_EVERY_MIN=360
# Supersede-detection overlap for the anti-conflict flow (spec §10.3;
# ADR-013 internal knob; default 0.5).
MEMORY_CONFLICT_OVERLAP=0.5
# --- Judge gate / multi-model panel (T05, spec §9 — Q5, ADR-008/010) ---
# Enabled judge models in priority order (default deepseek).
JUDGE_PANEL_MODELS=deepseek
# Consensus mode: any | majority (default any).
JUDGE_CONSENSUS=any
# Max judge panel size per verdict (default 3).
JUDGE_MAX_MODELS_PER_CALL=3
# Per-model judge timeout in seconds (default 30).
JUDGE_TIMEOUT_S=30
# Per-model monthly cost caps in USD (spec §9.5; cap -> auto-disable
# for the month; all capped -> consolidation pauses safely).
JUDGE_CAP_DEEPSEEK_USD=15
JUDGE_CAP_GPT4_USD=10
JUDGE_CAP_GEMINI3_USD=10
# Judge/reflection provider keys — env only, never in memory files,
# logs, PR bodies or artifacts (SEC-KEY-01..03, ADR-010). DeepSeek is
# available; OpenAI (gpt-4) and Google (gemini-3) activate the moment
# the owner provides the keys (Q5).
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ----------------------------------------------------------
# agent-desktop — Telegram bridge (T08, plan #22 T08/Q1/R7; runbook
# docs/TELEGRAM-BRIDGE.md — CHẠY TRONG SANDBOX TRƯỚC)
# ----------------------------------------------------------
# Bot token — LIVE mode only, env only, never in logs/artifacts
# (SEC-KEY-01..03). The bridge runs in SANDBOX (file transport, no
# network) until TELEGRAM_SANDBOX=0 AND this token are both set.
TELEGRAM_BOT_TOKEN=
# Chat id(s) notified about consolidation events (SEC-COST-02 spend
# report). Comma-separated list allowed.
TELEGRAM_CHAT_ID=
# Chat id(s) allowed to issue /memory commands (default: TELEGRAM_CHAT_ID).
TELEGRAM_ALLOWED_CHAT_IDS=
# Bot API base (default https://api.telegram.org).
TELEGRAM_API_BASE=
# getUpdates long-poll timeout in ms (default 2000).
TELEGRAM_POLL_INTERVAL_MS=2000
# Per-request timeout in seconds (default 30).
TELEGRAM_TIMEOUT_S=30
# 0 = live mode (requires TELEGRAM_BOT_TOKEN; owner laptop Q3). Unset or
# anything else = sandbox mode (file transport, no network, no token).
TELEGRAM_SANDBOX=
# Sandbox transport file (inbound commands + outbound evidence log;
# default <memoryDir>/telegram-sandbox.jsonl).
TELEGRAM_SANDBOX_FILE=
# Outbound message truncation length (default 4000; Telegram cap 4096).
TELEGRAM_MAX_MESSAGE_LENGTH=4000

# ----------------------------------------------------------
# Infrastructure
# ----------------------------------------------------------
POSTGRES_DB=agent_team
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me

# ----------------------------------------------------------
# Git integration (optional for the local prototype)
# ----------------------------------------------------------
GITHUB_TOKEN=
GITLAB_TOKEN=

# Repository the agents push to (used by `make demo` to set the
# project's repository_url). Leave empty to keep agents commit-only.
# Example: https://github.com/<owner>/<repo>.git
SEED_REPOSITORY_URL=

# Default branch of that repository (PR base / initial workspace branch).
SEED_DEFAULT_BRANCH=main

# ----------------------------------------------------------
# Redmine (project management + MCP bridge)
# ----------------------------------------------------------
# Host port for the Redmine UI (http://localhost:<REDMINE_PORT>)
REDMINE_PORT=3000

# Password of the "redmine" database user (own Postgres instance)
REDMINE_DB_PASSWORD=change-me

# Stable session secret — generate once with `openssl rand -hex 32`.
# If empty, the Redmine image auto-generates one per container start.
REDMINE_SECRET_KEY=

# Redmine API key for the MCP bridge. One-time manual setup:
#   1. docker compose up -d redmine
#   2. open http://localhost:3000, sign in as admin/admin, change password
#   3. Administration -> Settings -> API -> enable "Enable REST API"
#   4. My account -> API access key -> create (or, from the container:
#      docker compose exec redmine bundle exec rails runner \
#        "puts User.find_by(login: 'admin').api_key")
#   5. paste the key here, then: docker compose up -d redmine-mcp
REDMINE_API_KEY=

# Pin the MCP bridge image tag (third-party image, MIT):
# https://github.com/jztan/redmine-mcp-server
REDMINE_MCP_IMAGE_TAG=2.13.0

# ----------------------------------------------------------
# Odoo (accounting source for the accountant agent's monthly
# closing reports; bridge: docker/odoo-mcp, odoo-mcp package)
# ----------------------------------------------------------
# Base URL of the Odoo instance, e.g. https://mycompany.odoo.com
ODOO_URL=
# Database name and user credentials. For Odoo 16-18 XML-RPC use
# a login password or an external API key; for Odoo 19+ use
# ODOO_TRANSPORT=json2 + ODOO_API_KEY. Recommended: a dedicated
# read-only user with Accounting app access, never the admin.
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# Transport: xmlrpc (Odoo 16-18, default) or json2 (Odoo 19+)
ODOO_TRANSPORT=xmlrpc
ODOO_API_KEY=
ODOO_JSON2_DATABASE_HEADER=1

# Optional: inject context.lang on every Odoo call, e.g. vi_VN
ODOO_LOCALE=

# Pin the odoo-mcp PyPI version the bridge image installs:
# https://pypi.org/project/odoo-mcp/
ODOO_MCP_VERSION=1.3.0

# When Odoo runs in a separate docker-compose project, the bridge
# must join that project's network (run scripts/odoo-network.ps1,
# or: docker network connect <net> ai-team-odoo-mcp) and ODOO_URL
# becomes the service URL, e.g. http://<odoo-service>:8069. This
# variable is only read by scripts/odoo-network.ps1.
ODOO_DOCKER_NETWORK=

# ----------------------------------------------------------
# DeepSeek Harness build pinning
# ----------------------------------------------------------
# Reproducible builds: pin a commit sha (or branch/tag) of
# deepseek-ai/deepseek-harness. The default below is the commit
# this scaffold was written against (master @ 0.1.2-alpha.1).
DSH_REPO=https://github.com/deepseek-ai/deepseek-harness.git
DSH_REF=cd5ef8148158c3a752a658978873241fdf8e2bbc
