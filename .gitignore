# Secrets
.env

# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Orchestrator
orchestrator/node_modules/
orchestrator/dist/
orchestrator/.pnpm-store/

# Local pnpm content-addressable store (created at the workspace root
# when installing backend/ or orchestrator/ with the default store)
.pnpm-store/

# DSH / agent workspace state (run logs, profiles, credentials)
.dsh/
.agent-team/

# Agent workspaces (keep only the .gitkeep files)
workspaces/*/*
!workspaces/*/.gitkeep

# Local database data (postgres and redis bind-mount ./data)
data/*/*
!data/*/.gitkeep

# Editor / OS
.DS_Store
*.log

# Reference directories
.references/
data/observer.log
