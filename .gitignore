# Secrets
.env

# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Orchestrator
orchestrator/node_modules/
orchestrator/dist/
orchestrator/.pnpm-store/

# Local pnpm content-addressable store (created at workspace root when
# installing backend/ or orchestrator/ with the default store location)
.pnpm-store/

# Agent workspaces (keep only the .gitkeep files)
workspaces/*/*
!workspaces/*/.gitkeep

# Local database data (named volumes are used by compose;
# ./data is reserved for bind-mount deployments)
data/*/*
!data/*/.gitkeep

# Editor / OS
.DS_Store
*.log

# Reference directories
.references/
data/observer.log
