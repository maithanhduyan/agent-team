# Secrets
.env

# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Orchestrator
orchestrator/node_modules/
orchestrator/dist/
orchestrator/.pnpm-store/

# DSH / agent runner state (run logs, session data, profiles)
# .agent-team is created by the agent runner at the workspace root and
# must never be committed (crash-on-bootstrap incident, Redmine #26/#27)
.agent-team/

# DSH skill files and harness state (mounted read-only; never commit)
.dsh/

# Harness agent instructions at the repo root (mounted per-workspace) and
# pnpm package-manager store — never commit
/AGENTS.md
.pnpm-store/

# Agent workspaces (keep only the .gitkeep files)
workspaces/*/*
!workspaces/*/.gitkeep

# Local database data (named volumes are used by compose;
# ./data is reserved for bind-mount deployments)
data/*/*
!data/*/.gitkeep

# Editor / OS
.DS_Store
*.log

# Reference directories
.references/
data/observer.log

# agent-desktop — runtime memory data (created by the memory module;
# keep the directory README, never commit session/fact data)
agent-desktop/memory/*
!agent-desktop/memory/README.md

# agent-desktop — GEPA evolution run manifests (SEC-GEPA-11 audit
# records written by the T12 runner; keep the README, never commit
# generated run manifests — one dir per job under runs/)
agent-desktop/evolution/runs/**

# T14 harness — generated result JSON (commit only the golden reference)
agent-desktop/evolution/harness/results/*
!agent-desktop/evolution/harness/results/mode-a-reference.golden.json
