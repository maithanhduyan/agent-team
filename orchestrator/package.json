{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ai-dev-team orchestrator: task DB (PostgreSQL) + dispatch (Postgres source of truth) + agent registry + HTTP API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "ioredis": "^5.9.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
